{
  "name": "sports-desktop",
  "version": "0.1.0",
  "description": "Live sports and TV for macOS",
  "main": "dist/main/index.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "icon": "node scripts/app-icon.mjs",
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "check": "npm run check --workspace=@sports/core && npm run check --workspace=@sports/ui && npm run typecheck && npm test && npm run build",
    "pack": "npm run build && electron-builder --mac --dir",
    "release": "node scripts/release.mjs",
    "format": "prettier --write src tests scripts vite.config.ts tsconfig.json package.json"
  },
  "keywords": [],
  "author": "Nicolas Bonamy",
  "type": "module",
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@electron/osx-sign": "^2.7.0",
    "@types/node": "^26.5.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.11",
    "cheerio": "^1.2.0",
    "@sports/core": "0.1.0",
    "@sports/ui": "0.1.0",
    "vue": "^3.5.42"
  },
  "private": true,
  "build": {
    "appId": "fr.bonamy.sports.desktop",
    "productName": "Sports",
    "directories": {
      "output": "out"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "resources/icon.icns",
      "category": "public.app-category.sports",
      "target": [
        "dir"
      ],
      "identity": null
    }
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
